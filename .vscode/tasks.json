{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "workspace: ready terminal",
      "type": "shell",
      "command": "while [ ! -f \"${workspaceFolder}/.mona-codespace-ready\" ]; do sleep 1; done; echo 'Codespace ready. CLI tools available: gh and copilot.' && exec bash -l",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "^Codespace ready[.] CLI tools available: gh and copilot[.]$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true,
        "clear": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "app: install",
      "type": "shell",
      "command": "npm ci",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "problemMatcher": []
    },
    {
      "label": "app: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "dependsOn": [
        "app: install"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "3000"
        }
      }
    },
    {
      "label": "app: test",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "dependsOn": [
        "app: install"
      ],
      "problemMatcher": []
    }
  ]
}
